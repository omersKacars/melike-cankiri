---
import Layout from '../../layouts/Layout.astro';import {articles} from '../../data/articles';import {url} from '../../data/site';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.frontmatter.slug},props:{article}}));}
const {article}=Astro.props;const a=article.frontmatter;const Content=article.Content;const headings=article.getHeadings();
---
<Layout title={a.title+' | Av. Melike Çankırı'} description={a.description}><article class="container article content-section"><nav class="breadcrumb" aria-label="Sayfa yolu"><a href={url()}>Ana Sayfa</a><span>/</span><a href={url('yayinlar/')}>Yayınlar</a></nav><p class="eyebrow">{a.category}</p><h1>{a.title}</h1><p class="article-meta"><time datetime={a.date}>{new Date(a.date).toLocaleDateString('tr-TR')}</time> · {a.author}{a.readingTime && ' · '+a.readingTime+' dk okuma'}</p>{headings.length>0 && <nav class="toc" aria-label="İçindekiler"><h2>İçindekiler</h2><ul>{headings.filter((h:any)=>h.depth<=3).map((h:any)=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ul></nav>}<div class="reading markdown"><Content/></div>{a.updated && <p class="article-meta">Son güncelleme: {new Date(a.updated).toLocaleDateString('tr-TR')}</p>}<div class="notice">Bu yazı genel bilgilendirme amacı taşır; hukuki görüş veya danışmanlık niteliğinde değildir.</div><a class="text-link" href={url('iletisim/')}>Av. Melike Çankırı iletişim sayfası →</a></article></Layout>
