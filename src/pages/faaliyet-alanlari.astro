---
import Layout from '../layouts/Layout.astro';import PageTitle from '../components/PageTitle.astro';import {services} from '../data/services';import {url} from '../data/site';import Icon from '../components/Icon.astro';
---
<Layout title="Faaliyet Alanları | Av. Melike Çankırı"><PageTitle title="Faaliyet Alanları" description="Büronun hukuki çalışma alanlarına ilişkin genel bilgiler."/><section class="container content-section"><div class="two-grid"><div class="card service"><Icon name="book"/><h2>Avukatlık</h2><p>Hukuki danışmanlık ve hukuki süreçlerin takibi.</p></div><a class="card service" href={url('arabuluculuk/')}><Icon name="dialog"/><h2>Arabuluculuk</h2><p>Uyuşmazlıkların çözümüne yönelik arabuluculuk süreçleri.</p><span class="text-link">Süreç hakkında →</span></a></div>{services.filter(s=>s.confirmed).length>0 && <div class="contact-grid">{services.filter(s=>s.confirmed).map(s=><div class="card"><h3>{s.name}</h3><p>{s.description}</p></div>)}</div>}<div class="notice">Başvurunuzun konusu ve büronun çalışma alanlarına ilişkin bilgi için <a href={url('iletisim/')}>iletişim bilgilerine</a> ulaşabilirsiniz.</div></section></Layout>
