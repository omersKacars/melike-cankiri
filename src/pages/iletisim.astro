---
import Layout from '../layouts/Layout.astro';import PageTitle from '../components/PageTitle.astro';import Contact from '../components/Contact.astro';import Icon from '../components/Icon.astro';import {site,mapUrl,url} from '../data/site';
---
<Layout title="İletişim | Av. Melike Çankırı"><PageTitle title="İletişim" description="Telefon, e-posta ve ofis adresi."/><section class="container content-section"><Contact/>{site.whatsappEnabled && <p class="notice"><a href={'https://wa.me/'+site.phoneLink.replace('+','')} target="_blank" rel="noopener noreferrer">WhatsApp üzerinden iletişim</a></p>}<div class="location-panel"><div><p class="eyebrow">Ofis adresi</p><h2>Çanakkale / Merkez</h2><p>{site.address}</p><p class="hours"><Icon name="clock"/>{site.hours}</p></div><a class="button" href={mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin"/>Google Maps'te aç</a></div>{site.CONTACT_FORM_ENDPOINT && <form action={site.CONTACT_FORM_ENDPOINT} method="POST" class="contact-form"><h2>İletişim formu</h2><label>Ad Soyad<input name="name" autocomplete="name" required/></label><label>Telefon<input type="tel" name="phone" autocomplete="tel"/></label><label>E-posta<input type="email" name="email" autocomplete="email" required/></label><label>Mesaj<textarea name="message" rows="5" required/></label><label class="consent"><input type="checkbox" name="privacy_acknowledgement" required/> <span><a href={url('gizlilik/')}>Gizlilik bilgilendirmesini</a> okudum.</span></label><button class="button" type="submit">Gönder</button></form>}</section></Layout>
