---
import Layout from '../layouts/Layout.astro';import Icon from '../components/Icon.astro';import Contact from '../components/Contact.astro';import Steps from '../components/Steps.astro';import Publications from '../components/Publications.astro';import {site,url,mapUrl} from '../data/site';import {services} from '../data/services';
---
<Layout><section class="hero container"><div class="hero-copy"><p class="eyebrow"><span class="short-line"></span> Çanakkale · Hukuk & Arabuluculuk</p><h1>Av. Melike<br/><em>Çankırı</em></h1><h2>Hukuki süreçlerde açık iletişim<br class="desktop-break"/> ve profesyonel yaklaşım.</h2><p class="hero-description">Çanakkale'de avukatlık ve arabuluculuk faaliyetlerini sürdüren Av. Melike Çankırı'nın mesleki bilgi ve iletişim sayfası.</p><div class="actions"><a class="button" href={url('iletisim/')}>İletişim Bilgileri <Icon/></a><a class="text-link" href={mapUrl} target="_blank" rel="noopener noreferrer"><Icon name="pin"/>Konumu Gör</a></div><a class="hero-phone" href={'tel:'+site.phoneLink}><Icon name="phone"/>{site.phone}<span>Pazartesi–Cuma</span></a></div><figure class="hero-image"><img src={url('assets/office.webp')} width="800" height="1000" alt="Doğal ışıkta belgeler ve kalemden oluşan temsili çalışma masası" fetchpriority="high"/><figcaption><span>NET BİLGİ. KOLAY İLETİŞİM.</span><span>Hukuki süreçlere özenli bir yaklaşım.</span></figcaption></figure></section>
<section class="container quick-grid" aria-label="Mesleki bilgiler">{[['file','Çanakkale Barosu','Sicil No: 773'],['book','Avukatlık','Hukuki danışmanlık ve süreç takibi.'],['dialog','Arabuluculuk','Uyuşmazlık çözüm süreçleri.'],['pin','Çanakkale','Barbaros Mahallesi / Merkez']].map(([icon,title,text])=><div class="quick-card"><Icon name={icon}/><h3>{title}</h3><p>{text}</p></div>)}</section>
<section class="section container about-grid"><div><p class="eyebrow">Hakkında</p><h2>Hukukun odağında,<br/><em>açık iletişim.</em></h2></div><div><p class="lead">Av. Melike Çankırı, Çanakkale Barosu'na kayıtlı olarak avukatlık mesleğini Çanakkale'de sürdürmektedir.</p><p>Avukatlık faaliyetlerinin yanı sıra arabuluculuk süreçlerinde de görev almaktadır. Mesleki çalışmalarında hukuki sürecin taraflar açısından anlaşılır şekilde yürütülmesine, düzenli iletişime ve meslek ilkelerine uygun hizmet sunulmasına önem vermektedir.</p><a class="text-link" href={url('hakkinda/')}>Mesleki bilgiler <Icon/></a></div></section>
<section class="soft-section"><div class="container section"><div class="section-heading"><div><p class="eyebrow">Mesleki çalışmalar</p><h2>Faaliyet Alanları</h2></div><a class="text-link" href={url('faaliyet-alanlari/')}>Genel bilgiler <Icon/></a></div><div class="two-grid"><a class="card service" href={url('faaliyet-alanlari/')}><Icon name="book"/><h3>Avukatlık</h3><p>Hukuki danışmanlık ve hukuki süreçlerin takibi.</p><span class="card-bottom">Faaliyet bilgileri <Icon/></span></a><a class="card service" href={url('arabuluculuk/')}><Icon name="dialog"/><h3>Arabuluculuk</h3><p>Uyuşmazlıkların çözümüne yönelik arabuluculuk süreçleri.</p><span class="card-bottom">Süreç hakkında <Icon/></span></a></div>{services.filter(s=>s.confirmed).length>0 && <div class="contact-grid">{services.filter(s=>s.confirmed).map(s=><div class="card"><h3>{s.name}</h3><p>{s.description}</p></div>)}</div>}</div></section>
<section class="section container mediation"><div class="section-heading"><div><p class="eyebrow">Diyalog ve çözüm süreci</p><h2>Arabuluculuk</h2></div><a class="text-link" href={url('arabuluculuk/')}>Arabuluculuk hakkında <Icon/></a></div><p class="section-description">Arabuluculuk, uyuşmazlıkların tarafların katılımıyla, tarafsız bir üçüncü kişi eşliğinde çözülmesini amaçlayan alternatif uyuşmazlık çözüm yöntemlerinden biridir.</p><Steps/></section>
<section class="soft-section"><div class="container section"><div class="section-heading"><div><p class="eyebrow">Yayınlar</p><h2>Hukuki Bilgilendirmeler</h2></div><a class="text-link" href={url('yayinlar/')}>Tüm yayınlar <Icon/></a></div><Publications limit={3}/></div></section>
<section class="container section"><div class="section-heading"><div><p class="eyebrow">Bir telefon, bir e-posta</p><h2>İletişim Kurmak İçin</h2></div><p class="hours"><Icon name="clock"/>{site.hours}</p></div><Contact/></section></Layout>
